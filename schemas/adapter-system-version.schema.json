{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/content-generation-modules/schemas/adapter-system-version.schema.json",
  "title": "Content Generation Modules target adapter version",
  "type": "object",
  "required": [
    "schema_version",
    "helper_repository",
    "helper_version",
    "helper_commit",
    "modules"
  ],
  "properties": {
    "schema_version": {"const": "content-generation.adapter.v1"},
    "helper_repository": {"const": "https://github.com/Pukujan/content-generation-modules"},
    "helper_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "helper_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "modules": {
      "type": "array",
      "items": {"enum": ["brand-foundation", "content-context", "writing-direction", "visual-direction", "image-generation", "html-demo"]},
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "target_repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "target_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
  },
  "additionalProperties": true
}
